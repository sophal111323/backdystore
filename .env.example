# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── Admin auth ───────────────────────────────────────────────────────
ADMIN_JWT_SECRET="put-a-long-random-secret-at-least-32-chars-here"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Public URLs ──────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"
PUBLIC_DATA_REVALIDATE_SECONDS="10"

# ── 💳 Payment gateway: Tola Saint (https://tolasaint.com/docs) ──────
TOLA_SAINT_BASE_URL="https://api.tolasaint.com"
TOLA_SAINT_API_KEY=""            # from Tola Saint dashboard (x-api-key)
TOLA_SAINT_WEBHOOK_SECRET=""     # webhook signing secret
TOLA_SAINT_PROVIDER=""           # optional: "aba" | "bakong"

# Local testing only. NEVER set true in production.
PAYMENT_SIMULATION_MODE="false"
ALLOW_PUBLIC_PAYMENT_SYNC="false"

# ── 🎮 Game top-up providers ──────────────────────────────────────────
# Provider 1: Bay2Game (https://bay2game.xyz/developer_docs/)
BAY2GAME_BASE_URL="https://api.bay2game.xyz/api"
BAY2GAME_API_KEY=""              # from @Bay2GameBot → /profile

# Provider 2: Khmer TopUp (https://khmer-topup.com/api-docs)
KHMER_TOPUP_BASE_URL="https://khmer-topup.com/api/v1"
KHMER_TOPUP_API_KEY=""           # from https://khmer-topup.com/settings

# ── Telegram notifications ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── Security / cron secrets ──────────────────────────────────────────
INTERNAL_SECURITY_SECRET=""      # openssl rand -hex 32
CRON_SECRET=""                   # openssl rand -hex 32

# ── Cloudflare Turnstile Bot Protection ──────────────────────────────
# Public Storefront & Payment (Invisible Mode)
NEXT_PUBLIC_TURNSTILE_SITE_KEY_PUBLIC=""   # from Cloudflare Turnstile (Site Key - Invisible)
TURNSTILE_SECRET_KEY_PUBLIC=""             # from Cloudflare Turnstile (Secret Key)

# Admin Login (Non-interactive Mode)
NEXT_PUBLIC_TURNSTILE_SITE_KEY_ADMIN=""    # from Cloudflare Turnstile (Site Key - Non-interactive)
TURNSTILE_SECRET_KEY_ADMIN=""              # from Cloudflare Turnstile (Secret Key)

# Whitelist allowed domains (optional)
TURNSTILE_ALLOWED_HOSTNAMES="localhost,dytopup.site"

# ── Cloudflare analytics ─────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_ALERT_THRESHOLDS="1K,10K,20K,50K,100K,200K,500K,1M,2M,5M,10M,20M"
CLOUDFLARE_ALERT_METRIC="protected"

# ── Cloudinary (image uploads) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
